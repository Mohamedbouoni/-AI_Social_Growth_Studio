# =============================================================================
# AI Social Growth Studio — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Providers (free tiers) ---
# Set at least one key. Requests fall back through every configured provider:
#   English: Groq -> Gemini -> OpenRouter -> OpenAI
#   Arabic:  Gemini -> Groq -> OpenRouter -> OpenAI
# Free plan uses the *_FAST models, paid plans the *_QUALITY models.
# With no key at all, `next dev` uses a built-in mock; production refuses to start generations.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_QUALITY=llama-3.3-70b-versatile

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_QUALITY=gemini-2.5-flash

# OpenRouter (":free" models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional paid fallback (any OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local only: set AI_PROVIDER=ollama to use Ollama instead of the chain above
AI_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Token Encryption ---
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your-256-bit-hex-key

# --- Social OAuth: YouTube (Google) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Social OAuth: TikTok ---
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# --- Social OAuth: Instagram (Meta) ---
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# --- Payments: Konnect (Tunisia — bank card, e-Dinar, Flouci wallet) ---
# Sandbox dashboard: https://dashboard.sandbox.konnect.network
# Production API:    https://api.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_API_URL=https://api.preprod.konnect.network/api/v2

# --- App ---
# Must be publicly reachable in production: Konnect calls
# ${NEXT_PUBLIC_APP_URL}/api/billing/konnect/webhook after each payment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
